---
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import { whyFrym } from '../../data/why-frym';
---

<Section id="why" tint="raised" labelledby="why-title" class="why">
	<SectionHeader
		eyebrow="Not another budget tracker"
		title="Less budgeting work. More financial clarity."
		id="why-title"
	/>

	<ul class="why__grid">
		{
			whyFrym.map((item) => (
				<li class="why__item rule-top" data-emphasis={item.emphasis || undefined}>
					<h3 class="why__title">{item.title}</h3>
					<p class="why__body">{item.body}</p>
				</li>
			))
		}
	</ul>
</Section>

<style>
	.why__grid {
		display: grid;
		gap: 22px;
	}

	.why__item {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
		padding-top: 20px;
	}

	.why__title {
		font-size: var(--type-title-lg);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.why__body {
		line-height: 1.75;
	}

	@media (min-width: 768px) {
		.why__grid {
			grid-template-columns: 1fr 1fr;
			gap: 34px 48px;
		}
	}

	@media (min-width: 1024px) {
		.why__grid {
			gap: 44px 76px;
		}
	}
</style>
