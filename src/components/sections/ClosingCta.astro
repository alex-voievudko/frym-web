---
import Section from '../primitives/Section.astro';
import PillButton from '../primitives/PillButton.astro';
import { WAITLIST_ANCHOR } from '../../lib/site';
---

{/*
  The stack lives on a wrapper this component owns, not on Section's
  .container. A scoped rule cannot reach into a child component's element:
  the container carries Section's scope id, so `.closing :global(.container)`
  compiled fine and matched nothing, leaving the heading, lead and button
  with no spacing at all.
*/}
<Section pad="cta" labelledby="closing-title" class="closing">
	<div class="closing__stack">
		<h2 class="closing__title" id="closing-title">
			Your balance tells you what you have.
			<span class="closing__muted">Freem tells you what's Free.</span>
		</h2>

		<p class="closing__lead">
			See what your money is really available for. Get early access to Freem.
		</p>

		<PillButton href={WAITLIST_ANCHOR} size="lg" block>Get early access</PillButton>
	</div>
</Section>

<style>
	.closing {
		border-top: 1px solid var(--border-default);
	}

	/* 22 / 30 / 40 are the artboards' own gaps, not steps off the 4pt scale. */
	.closing__stack {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 22px;
	}

	.closing__title {
		font-size: var(--type-marketing-h2-cta);
		line-height: 1.04;
		letter-spacing: -0.05em;
		max-width: 900px;
	}

	/* The second clause drops to secondary so the contrast carries the point. */
	.closing__muted {
		display: block;
		color: var(--text-muted);
	}

	.closing__lead {
		font-size: var(--type-body-lg);
		line-height: 1.7;
		max-width: 480px;
	}

	@media (min-width: 768px) {
		.closing__stack {
			gap: 30px;
		}
	}
</style>
