---
import Section from '../primitives/Section.astro';
import WaitlistForm from '../waitlist/WaitlistForm.astro';
---

<Section
	id="waitlist"
	tint="dark"
	pad="waitlist"
	labelledby="waitlist-title"
	class="waitlist"
>
	<div class="waitlist__grid">
		<div class="waitlist__copy">
			<h2 class="waitlist__title" id="waitlist-title">
				Be one of the first to try Freem.
			</h2>

			<p class="waitlist__lead">
				Freem is currently being built for iOS and Android. Join the waitlist
				for early access and help shape the first version.
			</p>
		</div>

		<WaitlistForm />
	</div>
</Section>

<style>
	.waitlist__grid {
		display: grid;
		gap: var(--s-7);
	}

	.waitlist__copy {
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
	}

	.waitlist__title {
		font-size: var(--type-marketing-h2-waitlist);
		line-height: 1.06;
		letter-spacing: -0.05em;
		color: var(--text-onInverse);
	}

	.waitlist__lead {
		font-size: var(--type-body-lg);
		line-height: 1.7;
		color: var(--text-bodyOnInverse);
	}

	@media (min-width: 1200px) {
		.waitlist__grid {
			grid-template-columns: 1.06fr 0.94fr;
			gap: 76px;
			align-items: start;
		}
	}
</style>
