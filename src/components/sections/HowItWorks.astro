---
import Section from '../primitives/Section.astro';
import SectionHeader from '../primitives/SectionHeader.astro';
import DataRow from '../primitives/DataRow.astro';
import IconTile from '../primitives/IconTile.astro';
import Badge from '../primitives/Badge.astro';
import AllocationBar from '../primitives/AllocationBar.astro';
import ProgressRow from '../primitives/ProgressRow.astro';
import StatFigure from '../primitives/StatFigure.astro';
import { formatEur } from '../../lib/format';

// Members and accounts are told apart by initial, not by colour — the design
// system limits avatar grounds to these three.
const accounts = [
	{ initials: 'SN', name: 'Santander', ground: 'ink', value: 2850 },
	{ initials: 'RV', name: 'Revolut', ground: 'green', value: 800 },
	{ initials: 'CA', name: 'Cash', ground: 'track', value: 350 },
] as const;
---

<Section id="how" labelledby="how-title" class="how">
	<SectionHeader
		eyebrow="How Freem works"
		title="Start with reality. Add structure only where you need it."
		id="how-title"
	/>

	<ol class="how__grid">
		<li class="step rule-top">
			<span class="step__index">Step 01</span>
			<h3 class="step__title">Add your accounts</h3>
			<p class="step__body">Start with the money you actually have.</p>
			<div class="step__mock">
				{
					accounts.map((a) => (
						<DataRow label={a.name} value={formatEur(a.value)} height={40}>
							<span slot="lead" class="avatar" data-ground={a.ground}>
								{a.initials}
							</span>
						</DataRow>
					))
				}
			</div>
		</li>

		<li class="step rule-top">
			<span class="step__index">Step 02</span>
			<h3 class="step__title">Add commitments</h3>
			<p class="step__body">
				Bills, subscriptions and upcoming payments become Locked.
			</p>
			<div class="step__mock">
				<DataRow
					label="Rent"
					meta="Due in 3 days"
					metaTone="warning"
					height={40}
					rule="none"
				>
					<IconTile slot="lead" name="home" size={30} />
					<Badge tone="neutral">Locked</Badge>
				</DataRow>
			</div>
		</li>

		<li class="step rule-top">
			<span class="step__index">Step 03</span>
			<h3 class="step__title">Plan spending</h3>
			<p class="step__body">
				Money you intend to use for everyday spending becomes Planned.
			</p>
			<div class="step__mock step__mock--plan">
				<DataRow label="Groceries" height={40} rule="none">
					<Badge tone="reserved">Planned</Badge>
				</DataRow>
				<ProgressRow label="Groceries" spent={320} planned={380} />
			</div>
		</li>

		<li class="step rule-top" data-emphasis>
			<span class="step__index">Step 04</span>
			<h3 class="step__title">See what's Free</h3>
			<p class="step__body">
				Everything left is yours to decide what to do with.
			</p>
			<div class="step__mock step__mock--free">
				<AllocationBar free={1800} reserved={900} locked={1300} height={10} />
				<div class="step__free">
					<span class="step__free-label">Free</span>
					<StatFigure value={1800} size="sm" />
				</div>
			</div>
		</li>
	</ol>
</Section>

<style>
	.how {
		border-top: 1px solid var(--border-default);
	}

	.how__grid {
		display: grid;
		gap: 24px;
	}

	.step {
		display: flex;
		flex-direction: column;
		gap: 14px;
		padding-top: 20px;
	}

	.step__index {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--mono-label-lg);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-muted);
		line-height: 1;
	}

	.step__title {
		font-size: var(--type-title-lg);
		line-height: 1.3;
		letter-spacing: -0.02em;
	}

	.step__body {
		line-height: 1.7;
	}

	.step__mock {
		margin-top: auto;
		padding-top: var(--s-2);
	}

	.step__mock--plan,
	.step__mock--free {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
	}

	.avatar {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 26px;
		height: 26px;
		flex: none;
		border-radius: var(--r-tile);
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--mono-initial);
		letter-spacing: 0.04em;
		line-height: 1;
	}

	.avatar[data-ground='ink'] {
		background: var(--surface-inverse);
		color: var(--surface-default);
	}
	.avatar[data-ground='green'] {
		background: var(--text-accent);
		color: var(--surface-default);
	}
	.avatar[data-ground='track'] {
		background: var(--surface-sunken);
		color: var(--text-primary);
	}

	.step__free {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--s-3);
	}

	.step__free-label {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--mono-label-lg);
		letter-spacing: 0.2em;
		text-transform: uppercase;
		color: var(--text-primary);
	}

	@media (min-width: 768px) {
		.how__grid {
			grid-template-columns: 1fr 1fr;
			gap: 36px 48px;
		}
	}

	@media (min-width: 1200px) {
		.how__grid {
			grid-template-columns: repeat(4, 1fr);
			gap: 36px;
		}
	}
</style>
