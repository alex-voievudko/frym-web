---
import PillButton from '../primitives/PillButton.astro';
import { WAITLIST_ANCHOR } from '../../lib/site';
---

{/*
  Mobile-only. The artboard faked this with a negative margin over the footer;
  here it is genuinely fixed, and SiteFooter reserves --mobile-bar-h of bottom
  padding so nothing is ever covered.
*/}
<div class="cta-bar">
	<div class="cta-bar__labels">
		<span class="cta-bar__title">Free to spend</span>
		<span class="cta-bar__meta">Pre-launch · iPhone first</span>
	</div>
	<span class="cta-bar__action">
		<PillButton href={WAITLIST_ANCHOR} size="md">Join waitlist</PillButton>
	</span>
</div>

<style>
	.cta-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 14px;
		background: var(--c-paper);
		border-top: 1px solid var(--c-divider);
		padding: 12px var(--gutter) calc(16px + env(safe-area-inset-bottom));
	}

	.cta-bar__labels {
		display: flex;
		flex-direction: column;
		gap: 5px;
		font-family: var(--font-mono);
		text-transform: uppercase;
		line-height: 1.3;
		/* Lets the labels wrap rather than push the pill off-screen on
		   narrow devices; a flex item will not shrink past its content
		   width without this. */
		min-width: 0;
	}

	.cta-bar__title {
		font-weight: 500;
		font-size: var(--fs-mono-label);
		letter-spacing: 0.2em;
		color: var(--c-ink);
	}

	.cta-bar__action {
		display: inline-flex;
		flex: none;
	}

	.cta-bar__meta {
		font-weight: 400;
		font-size: var(--fs-mono-xs);
		letter-spacing: 0.12em;
		color: var(--c-secondary);
	}

	@media (min-width: 768px) {
		.cta-bar {
			display: none;
		}
	}
</style>
