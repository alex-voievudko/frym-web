---
import PillButton from '../primitives/PillButton.astro';
import ValidationQuestion from './ValidationQuestion.astro';
import { site } from '../../lib/site';
---

<div class="wl" data-wl data-state="idle">
	<form class="wl__form" data-wl-form novalidate>
		<div class="wl__fields">
			<p class="field">
				<label class="field__label" for="wl-email">Email</label>
				<input
					class="field__input"
					id="wl-email"
					name="email"
					type="email"
					required
					autocomplete="email"
					inputmode="email"
					spellcheck="false"
					autocapitalize="off"
					enterkeyhint="go"
					placeholder="you@example.com"
					aria-describedby="wl-hint"
				/>
			</p>

			<p class="field">
				<label class="field__label" for="wl-name">First name · Optional</label>
				<input
					class="field__input"
					id="wl-name"
					name="name"
					type="text"
					autocomplete="given-name"
					placeholder="Sam"
				/>
			</p>
		</div>

		{/* Off-screen rather than display:none — bots skip hidden inputs. */}
		<div class="visually-hidden" aria-hidden="true">
			<label>
				Company
				<input name="company" tabindex="-1" autocomplete="off" />
			</label>
		</div>

		<p class="wl__error" id="wl-error" role="alert" data-wl-error></p>

		<div class="wl__submit">
			<PillButton type="submit" variant="light" size="lg" block class="wl__button">
				<span data-wl-button-label>Join the waitlist</span>
			</PillButton>
			<p class="wl__note" id="wl-hint">No spam · Early access only</p>
		</div>
	</form>

	<div class="wl__success" data-wl-success hidden>
		<h3 class="wl__success-title" data-wl-success-title tabindex="-1">
			You're on the list.
		</h3>
		<p class="wl__success-copy" data-wl-success-copy>
			Thanks for joining Frym. We'll let you know when early access opens.
		</p>
		<ValidationQuestion />
	</div>

	<noscript>
		<p class="wl__noscript">
			Email <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a> and we
			will add you to the waitlist.
		</p>
	</noscript>
</div>

<script>
	import { waitlist } from '../../lib/waitlist';
	import type { ValidationOptionId } from '../../lib/waitlist/types';

	const ERRORS: Record<string, string> = {
		'invalid-email': 'Enter an email address we can reach you at.',
		'rate-limited': 'Too many attempts just now. Try again in a moment.',
		network: 'We could not reach the server. Check your connection and try again.',
		server: 'Something went wrong on our side. Please try again.',
		unknown: 'Something went wrong. Please try again.',
	};

	for (const root of document.querySelectorAll<HTMLElement>('[data-wl]')) {
		setup(root);
	}

	function setup(root: HTMLElement) {
		const form = root.querySelector<HTMLFormElement>('[data-wl-form]')!;
		const email = root.querySelector<HTMLInputElement>('#wl-email')!;
		const honeypot = form.elements.namedItem('company') as HTMLInputElement;
		const errorEl = root.querySelector<HTMLElement>('[data-wl-error]')!;
		const buttonLabel = root.querySelector<HTMLElement>('[data-wl-button-label]')!;
		const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const success = root.querySelector<HTMLElement>('[data-wl-success]')!;
		const successTitle = root.querySelector<HTMLElement>('[data-wl-success-title]')!;
		const successCopy = root.querySelector<HTMLElement>('[data-wl-success-copy]')!;
		const vq = root.querySelector<HTMLElement>('[data-vq]');

		const renderedAt = Date.now();
		let joinedEmail = '';

		const setState = (state: string) => root.setAttribute('data-state', state);

		function showError(message: string) {
			errorEl.textContent = message;
			email.setAttribute('aria-invalid', 'true');
			email.setAttribute('aria-describedby', 'wl-error');
			setState('idle');
			email.focus();
		}

		function clearError() {
			if (!errorEl.textContent) return;
			errorEl.textContent = '';
			email.removeAttribute('aria-invalid');
			email.setAttribute('aria-describedby', 'wl-hint');
		}

		// Any edit returns to a clean slate, so the error never outlives the
		// input that caused it.
		form.addEventListener('input', clearError);

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			if (root.dataset.state === 'submitting') return;

			clearError();
			setState('submitting');
			buttonLabel.textContent = 'Joining…';
			submit.disabled = true;
			submit.setAttribute('aria-busy', 'true');
			email.readOnly = true;

			let result;
			try {
				result = await waitlist.join({
					email: email.value,
					source: 'waitlist',
					hp: honeypot?.value,
					elapsedMs: Date.now() - renderedAt,
				});
			} catch {
				result = { ok: false, reason: 'network' } as const;
			}

			buttonLabel.textContent = 'Join the waitlist';
			submit.disabled = false;
			submit.removeAttribute('aria-busy');
			email.readOnly = false;

			if (!result.ok) {
				showError(ERRORS[result.reason] ?? ERRORS.unknown);
				return;
			}

			joinedEmail = email.value.trim();
			const already = result.status === 'already-joined';

			if (already) {
				successTitle.textContent = "You're already on the list.";
				successCopy.textContent =
					"You're already on the Frym waitlist. We'll let you know when early access opens.";
			}

			form.hidden = true;
			success.hidden = false;
			// A live region is unreliable for a swap this large, so move focus
			// instead; the heading is the new start of the flow.
			successTitle.focus();

			// Someone who signed up earlier has already been asked.
			if (vq && !already) vq.hidden = false;
			setState(already ? 'already' : 'joined');
		});

		if (vq) setupQuestion(vq, () => joinedEmail, setState);
	}

	function setupQuestion(
		vq: HTMLElement,
		getEmail: () => string,
		setState: (s: string) => void,
	) {
		const options = vq.querySelector<HTMLElement>('[data-vq-options]')!;
		const noted = vq.querySelector<HTMLElement>('[data-vq-noted]')!;
		const choice = vq.querySelector<HTMLElement>('[data-vq-choice]')!;
		const buttons = [...vq.querySelectorAll<HTMLButtonElement>('[data-option]')];

		for (const button of buttons) {
			button.addEventListener('click', async () => {
				buttons.forEach((b) => (b.disabled = true));
				button.setAttribute('aria-pressed', 'true');
				setState('answering');

				try {
					await waitlist.answer({
						email: getEmail(),
						optionId: button.dataset.option as ValidationOptionId,
					});
				} catch {
					// The signup already succeeded, which is the thing that matters.
					// A failed answer must never walk that back.
				}

				choice.textContent = button.textContent!.trim();
				options.hidden = true;
				noted.hidden = false;
				setState('answered');
			});
		}
	}
</script>

<style>
	.wl {
		display: flex;
		flex-direction: column;
	}

	.wl__form {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}

	.wl__fields {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}

	/* "A field is a label and a rule" — no boxed inputs anywhere. */
	.field {
		display: flex;
		flex-direction: column;
		gap: 7px;
	}

	.field__label {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--fs-mono-sm);
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--c-secondary);
		line-height: 1;
	}

	.field__input {
		height: 44px;
		width: 100%;
		background: transparent;
		border: none;
		border-bottom: 1.5px solid var(--c-dark-rule-hi);
		border-radius: 0;
		outline: none;
		padding: 0;
		color: var(--c-dark-text);
		/* 16px at every width; anything smaller zooms the viewport on iOS. */
		font-size: var(--fs-input);
		transition: border-color var(--t-hover) var(--ease);
	}

	.field__input::placeholder {
		color: var(--c-secondary);
	}

	/* Focus thickens and brightens the rule — never a ring or a glow. */
	.field__input:focus-visible {
		border-bottom-color: var(--c-dark-text);
		outline: none;
	}

	.field__input[aria-invalid] {
		border-bottom-color: var(--c-dark-error);
	}

	.wl__error {
		font-size: 0.75rem; /* 12 */
		line-height: 1.55;
		color: var(--c-dark-error);
	}

	.wl__error:empty {
		display: none;
	}

	.wl__submit {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--s-4);
	}

	/* Fixed width so swapping in "Joining…" cannot reflow the row. */
	.wl__button {
		min-width: 15rem;
	}

	.wl__note {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--fs-mono-sm);
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--c-secondary);
		line-height: 1;
		text-align: center;
	}

	.wl__success {
		display: flex;
		flex-direction: column;
		gap: var(--s-3);
		border-top: 1px solid var(--c-dark-rule-hi);
		padding-top: var(--s-6);
	}

	.wl__success-title {
		font-size: var(--fs-h2-faq);
		line-height: 1.1;
		letter-spacing: -0.04em;
		color: var(--c-dark-text);
	}

	.wl__success-title:focus-visible {
		outline: 2px solid var(--c-dark-text);
		outline-offset: 4px;
	}

	.wl__success-copy {
		font-size: var(--fs-lead-sm);
		line-height: 1.7;
		color: var(--c-dark-body);
	}

	.wl__noscript {
		margin-top: var(--s-5);
		line-height: 1.7;
		color: var(--c-dark-body);
	}

	.wl__noscript a {
		color: var(--c-dark-text);
		text-decoration: underline;
	}

	@media (min-width: 768px) {
		.wl__submit {
			flex-direction: row;
			align-items: center;
			gap: var(--s-5);
		}

		.wl__note {
			text-align: left;
		}

		/* Tablet has the room for the two fields side by side; the narrower
		   desktop column does not, so they stack again at 1024. */
		.wl__fields {
			flex-direction: row;
			gap: 26px;
		}

		.wl__fields .field:first-child {
			flex: 1.3;
		}

		.wl__fields .field:last-child {
			flex: 1;
		}
	}

	@media (min-width: 1024px) {
		.wl__fields {
			flex-direction: column;
			gap: var(--s-6);
		}
	}
</style>
