---
/**
 * State tag: tint ground, semantic label, no border. Radius 3 is the one
 * non-pill radius in the system, so tags never read as pressable.
 */
interface Props {
	tone?: 'neutral' | 'reserved' | 'warning' | 'negative';
	class?: string;
}

const { tone = 'neutral', class: className } = Astro.props;
---

<span class:list={['badge', className]} data-tone={tone}><slot /></span>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		flex: none;
		border-radius: var(--r-tag);
		padding: 3px 7px;
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: var(--mono-tag);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		line-height: 1.2;
		white-space: nowrap;
	}

	.badge[data-tone='neutral'] {
		background: var(--surface-sunken);
		color: var(--text-secondary);
	}
	.badge[data-tone='reserved'] {
		background: var(--surface-accent-subtle);
		color: var(--text-accent);
	}
	.badge[data-tone='warning'] {
		background: var(--surface-warning-subtle);
		color: var(--text-warning);
	}
	.badge[data-tone='negative'] {
		background: var(--surface-danger-subtle);
		color: var(--text-danger);
	}
</style>
