---
/**
 * Category plan progress: label, square 4px track, and a `spent / planned`
 * fraction whose denominator is faint.
 *
 * Tone: on track, at risk from 95%, over past 100 (clamped). The V1 doc puts
 * the at-risk threshold at 80%, but the artboards draw 320/380 (84%) on track
 * and only 218/220 (99%) at risk, so the page follows the artboards.
 */
interface Props {
	label: string;
	spent: number;
	planned: number;
	class?: string;
}

const { label, spent, planned, class: className } = Astro.props;

const ratio = planned === 0 ? 0 : spent / planned;
const pct = Math.min(ratio, 1) * 100;
const tone = ratio > 1 ? 'over' : ratio >= 0.95 ? 'atRisk' : 'onTrack';
---

<div class:list={['prow', className]}>
	<span class="prow__label">{label}</span>
	<span
		class="prow__track"
		role="img"
		aria-label={`${label}: ${spent} of ${planned} planned`}
	>
		<span class="prow__fill" data-tone={tone} style={`width:${pct}%`}></span>
	</span>
	<span class="prow__fraction tnum" aria-hidden="true">
		{spent}<span class="prow__denominator">&nbsp;/ {planned}</span>
	</span>
</div>

<style>
	.prow {
		display: flex;
		align-items: center;
		gap: var(--s-3);
	}

	/* Sans, not Mono — the artboard sets these category names in Sans. */
	.prow__label {
		flex: none;
		width: 72px;
		font-family: var(--font-sans);
		font-weight: 500;
		font-size: var(--type-label-md);
		color: var(--text-primary);
		line-height: 1.2;
	}

	/* Meters are square — the design system exempts them from the radius scale. */
	.prow__track {
		flex: 1;
		min-width: 0;
		height: 4px;
		background: var(--meter-track);
	}

	.prow__fill {
		display: block;
		height: 100%;
	}

	.prow__fill[data-tone='onTrack'] {
		background: var(--meter-fill-secondary);
	}
	.prow__fill[data-tone='atRisk'] {
		background: var(--money-atRisk);
	}
	.prow__fill[data-tone='over'] {
		background: var(--money-over);
	}

	.prow__fraction {
		flex: none;
		width: 74px;
		text-align: right;
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: 0.6875rem; /* 11 */
		color: var(--text-primary);
		line-height: 1;
	}

	.prow__denominator {
		color: var(--text-faint);
	}
</style>
