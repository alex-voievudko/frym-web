---
import { Font } from 'astro:assets';
import { Icon } from 'astro-icon/components';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<title>Spike</title>
		<Font cssVariable="--font-sans" preload />
		<Font cssVariable="--font-mono" />
	</head>
	<body>
		<h1>Know what you can actually spend.</h1>
		<p class="mono">PERSONAL FINANCE, SIMPLIFIED</p>
		<Icon name="hugeicons:wallet-01" width={18} height={18} />
		<Icon name="hugeicons:coins-01" width={18} height={18} />
	</body>
</html>

<style>
	h1 {
		font-family: var(--font-sans);
		font-weight: 600;
		font-size: 76px;
		line-height: 1;
		letter-spacing: -0.05em;
	}
	.mono {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 11px;
		letter-spacing: 0.22em;
	}
</style>
