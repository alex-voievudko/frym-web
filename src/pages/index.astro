---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import BalanceNotBudget from '../components/sections/BalanceNotBudget.astro';
import ThreeStates from '../components/sections/ThreeStates.astro';
import HowItWorks from '../components/sections/HowItWorks.astro';
import SimpleExample from '../components/sections/SimpleExample.astro';
import WhyFrym from '../components/sections/WhyFrym.astro';
import Waitlist from '../components/sections/Waitlist.astro';

// Features and WhatComesNext are unmounted — the 2026-08-15 artboards drop
// both sections. The components are kept so restoring either is one import
// away, but they still match the previous artboard, not the current one.
import Faq from '../components/sections/Faq.astro';
import ClosingCta from '../components/sections/ClosingCta.astro';
---

<BaseLayout>
	<Hero />
	<BalanceNotBudget />
	<ThreeStates />
	<HowItWorks />
	<SimpleExample />
	<WhyFrym />
	<Waitlist />
	<Faq />
	<ClosingCta />
</BaseLayout>
