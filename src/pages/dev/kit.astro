---
/**
 * Temporary component gallery for building against the artboards.
 * Deleted in the polish step. Not indexed, not linked from anywhere.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';

const typeScale = [
	['--fs-h1', 'h1 hero', '40 → 76'],
	['--fs-h2', 'h2 section', '29 → 46'],
	['--fs-h2-waitlist', 'h2 waitlist', '32 → 52'],
	['--fs-h2-cta', 'h2 closing', '32 → 64'],
	['--fs-h2-faq', 'h2 faq', '26 → 34'],
	['--fs-h2-next', 'h2 what next', '24 → 34'],
	['--fs-figure', 'hero figure', '56 → 84'],
	['--fs-card-title', 'card title', '18 → 22'],
	['--fs-step-title', 'step title', '17 → 19'],
	['--fs-faq-q', 'faq question', '15.5 → 18'],
	['--fs-lead', 'hero lead', '15.5 → 19'],
	['--fs-lead-sm', 'section lead', '14.5 → 16'],
	['--fs-body', 'body', '14 → 14.5'],
	['--fs-caption', 'caption', '12.5 → 13'],
	['--fs-eyebrow', 'eyebrow (mono)', '10 → 11'],
	['--fs-btn', 'button (mono)', '10.5 → 11'],
	['--fs-input', 'input', '16 fixed'],
];

const padScale = [
	['--pad-section', '52 → 92'],
	['--pad-hero-top', '44 → 104'],
	['--pad-hero-bot', '48 → 96'],
	['--pad-next', '48 → 80'],
	['--pad-waitlist', '52 → 96'],
	['--pad-cta', '56 → 104'],
	['--gutter', '20 → 48'],
];

const palette = [
	['--c-paper', 'paper'],
	['--c-paper-hi', 'paper-hi'],
	['--c-raised', 'raised'],
	['--c-track', 'track'],
	['--c-ink', 'ink'],
	['--c-body', 'body'],
	['--c-secondary', 'secondary'],
	['--c-faint', 'faint'],
	['--c-divider', 'divider'],
	['--c-divider-soft', 'divider-soft'],
	['--c-free', 'free'],
	['--c-reserved', 'reserved'],
	['--c-locked', 'locked'],
	['--c-green', 'green'],
	['--c-green-light', 'green-light'],
	['--c-green-pale', 'green-pale'],
	['--c-green-dark', 'green-dark'],
	['--c-ochre', 'ochre'],
	['--c-ochre-tint', 'ochre-tint'],
	['--c-brick', 'brick'],
	['--c-brick-tint', 'brick-tint'],
];
---

<BaseLayout title="Frym — dev kit" noindex bare>
	<div class="container kit">
		<p class="eyebrow">DEV KIT · NOT SHIPPED</p>
		<p id="readout" class="mono readout">viewport —</p>

		<h2 class="kit__h">Type scale</h2>
		<table class="specs">
			<thead>
				<tr><th>token</th><th>target</th><th>computed</th></tr>
			</thead>
			<tbody>
				{
					typeScale.map(([token, label, target]) => (
						<tr>
							<td>
								{label}
								<code>{token}</code>
							</td>
							<td>{target}</td>
							<td data-measure={token} />
						</tr>
					))
				}
			</tbody>
		</table>

		<h2 class="kit__h">Vertical rhythm &amp; layout</h2>
		<table class="specs">
			<thead>
				<tr><th>token</th><th>target</th><th>computed</th></tr>
			</thead>
			<tbody>
				{
					padScale.map(([token, target]) => (
						<tr>
							<td><code>{token}</code></td>
							<td>{target}</td>
							<td data-measure={token} />
						</tr>
					))
				}
				<tr>
					<td><code>.container</code> content width</td>
					<td>350 / 738 / 1160</td>
					<td id="container-w"></td>
				</tr>
			</tbody>
		</table>

		<h2 class="kit__h">Specimens</h2>
		<div class="specimens">
			<h1 style="font-size:var(--fs-h1);line-height:var(--lh-h1);letter-spacing:var(--tr-h1)">
				Know what you can actually spend.
			</h1>
			<h2 style="font-size:var(--fs-h2);line-height:var(--lh-h2);letter-spacing:var(--tr-h2)">
				Having €4,000 does not mean you have €4,000 to spend.
			</h2>
			<p class="eyebrow">THREE SIMPLE STATES</p>
			<p style="font-size:var(--fs-lead);line-height:1.6">
				Your bank balance shows how much money you have.
				<strong style="font-weight:600;color:var(--c-ink)">
					Frym shows how much is genuinely free
				</strong> after bills, subscriptions and planned spending are already accounted
				for.
			</p>
			<p style="max-width:var(--prose)">
				Some of that money already belongs to rent. Some is needed for bills. Some
				is what you planned for groceries, transport or dining. The problem is that
				your bank account still shows all of it as one balance.
			</p>
		</div>

		<h2 class="kit__h">Palette</h2>
		<ul class="swatches">
			{
				palette.map(([token, label]) => (
					<li>
						<span class="swatch" style={`background:var(${token})`} />
						<span class="swatch__label mono">{label}</span>
						<span class="swatch__hex mono" data-hex={token} />
					</li>
				))
			}
		</ul>
	</div>
</BaseLayout>

<script>
	const root = document.documentElement;

	// A custom property computes to its token sequence, so getPropertyValue
	// returns the literal `clamp(...)` string, not a length. Resolving it means
	// applying it to a real property and reading that back.
	const probe = document.createElement('div');
	probe.style.cssText = 'position:absolute;visibility:hidden;width:0;height:0';
	document.body.appendChild(probe);

	function resolve(token: string) {
		probe.style.fontSize = `var(${token})`;
		return Math.round(parseFloat(getComputedStyle(probe).fontSize) * 100) / 100;
	}

	function refresh() {
		const cs = getComputedStyle(root);

		for (const el of document.querySelectorAll<HTMLElement>('[data-measure]')) {
			el.textContent = `${resolve(el.dataset.measure!)}px`;
		}
		for (const el of document.querySelectorAll<HTMLElement>('[data-hex]')) {
			el.textContent = cs.getPropertyValue(el.dataset.hex!).trim().toUpperCase();
		}

		const container = document.querySelector('.container');
		if (container) {
			const cw = getComputedStyle(container);
			const inner =
				container.clientWidth -
				parseFloat(cw.paddingLeft) -
				parseFloat(cw.paddingRight);
			document.getElementById('container-w')!.textContent = `${Math.round(inner)}px`;
		}

		document.getElementById('readout')!.textContent =
			`viewport ${window.innerWidth} × ${window.innerHeight}`;
	}

	refresh();
	window.addEventListener('resize', refresh);
</script>

<style>
	.kit {
		padding-block: var(--s-7) 6rem;
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
	}

	.readout {
		font-size: var(--fs-mono-label);
		letter-spacing: 0.14em;
		color: var(--c-ink);
	}

	.kit__h {
		font-size: var(--fs-card-title);
		border-top: 1px solid var(--c-ink);
		padding-top: var(--s-4);
		margin-top: var(--s-5);
	}

	.specs {
		border-collapse: collapse;
		width: 100%;
		max-width: 640px;
		font-family: var(--font-mono);
		font-size: var(--fs-mono-sm);
	}

	.specs th {
		text-align: left;
		text-transform: uppercase;
		letter-spacing: 0.14em;
		color: var(--c-secondary);
		font-weight: 500;
		padding-bottom: var(--s-2);
		border-bottom: 1px solid var(--c-divider);
	}

	.specs td {
		padding: 7px 0;
		border-bottom: 1px solid var(--c-divider-soft);
		color: var(--c-ink);
	}

	.specs td:not(:first-child) {
		text-align: right;
		width: 7rem;
	}

	.specs code {
		display: block;
		color: var(--c-secondary);
		font-size: var(--fs-mono-xs);
	}

	.specimens {
		display: flex;
		flex-direction: column;
		gap: var(--s-5);
	}

	.swatches {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
		gap: var(--s-3);
	}

	.swatches li {
		display: flex;
		flex-direction: column;
		gap: 5px;
	}

	.swatch {
		display: block;
		height: 48px;
		border: 1px solid var(--c-divider);
	}

	.swatch__label {
		font-size: var(--fs-mono-xs);
		letter-spacing: 0.12em;
		color: var(--c-ink);
	}

	.swatch__hex {
		font-size: var(--fs-mono-xs);
		letter-spacing: 0.12em;
		color: var(--c-secondary);
	}
</style>
