---
import BaseLayout from './BaseLayout.astro';
import { site } from '../lib/site';

interface Props {
	title: string;
	description: string;
	updated: string;
}

const { title, description, updated } = Astro.props;
---

<BaseLayout title={`${title} — ${site.name}`} {description}>
	<article class="legal">
		<div class="container legal__inner">
			<header class="legal__head">
				<p class="eyebrow">{site.name}</p>
				<h1 class="legal__title">{title}</h1>
				<p class="legal__updated">Last updated {updated}</p>
			</header>

			<div class="legal__body">
				<slot />
			</div>
		</div>
	</article>
</BaseLayout>

<style>
	.legal {
		padding-block: var(--pad-section);
	}

	.legal__inner {
		display: flex;
		flex-direction: column;
		gap: var(--s-7);
	}

	.legal__head {
		display: flex;
		flex-direction: column;
		gap: var(--s-4);
		border-bottom: 1px solid var(--border-default);
		padding-bottom: var(--s-6);
	}

	.legal__title {
		font-size: var(--type-headline-lg);
		line-height: var(--lh-h2);
		letter-spacing: var(--tr-h2);
	}

	.legal__updated {
		font-family: var(--font-mono);
		font-weight: 400;
		font-size: var(--mono-meta);
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: var(--text-muted);
		line-height: 1;
	}

	.legal__body {
		display: flex;
		flex-direction: column;
		gap: var(--s-6);
		/* The artboards were fixed-width and set no measure; unbounded prose
		   at 1160px reads badly. */
		max-width: var(--prose);
	}

	.legal__body :global(h2) {
		font-size: var(--type-title-lg);
		line-height: 1.3;
		letter-spacing: -0.02em;
		margin-bottom: var(--s-3);
	}

	.legal__body :global(p) {
		line-height: 1.75;
	}

	.legal__body :global(p + p) {
		margin-top: var(--s-3);
	}

	.legal__body :global(ul) {
		display: flex;
		flex-direction: column;
		gap: var(--s-2);
		margin-top: var(--s-3);
	}

	.legal__body :global(li) {
		position: relative;
		padding-left: var(--s-4);
		line-height: 1.75;
	}

	.legal__body :global(li)::before {
		content: '';
		position: absolute;
		left: 0;
		top: 0.75em;
		width: 5px;
		height: 1px;
		background: var(--text-faint);
	}

	.legal__body :global(a) {
		color: var(--text-accent);
		text-decoration: underline;
		text-underline-offset: 2px;
	}
</style>
